# ÖRNEK ortam değişkenleri — GERÇEK DEĞER İÇERMEZ.
#
# Yerel kurulum:  bu dosyayı ".env" adıyla kopyala ve değerleri doldur.
# Vercel:         Project Settings > Environment Variables bölümüne tek tek gir.

# --- Veritabanı (Neon PostgreSQL) ---
# Neon panelinde: Dashboard > Connection string
DATABASE_URL="postgresql://kullanici:sifre@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Site adresi ---
# Yerelde: http://localhost:3000
# Canlıda: https://www.dedektiforhan.com
# ★ Bu değer localhost içeriyorsa ödeme sistemi otomatik olarak TEST moduna
#   düşer — PayTR bildirimi localhost'a ulaşamayacağı için.
NEXT_PUBLIC_SITE_URL="https://www.dedektiforhan.com"

# --- Oturum güvenliği ---
# Üretim için rastgele üret:  openssl rand -base64 32
# ★ Bu değeri değiştirmek tüm açık oturumları sonlandırır (herkes yeniden giriş yapar).
AUTH_SECRET="buraya-uzun-rastgele-bir-anahtar"
AUTH_TRUST_HOST="true"

# --- PayTR (Bilgi > Entegrasyon Bilgileri) ---
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
# 1 = PayTR test kartlarıyla dene · 0 = gerçek tahsilat
PAYTR_TEST_MODE="1"

# --- E-posta (şifre sıfırlama, randevu bildirimi) ---
# Boş bırakılırsa e-postalar gönderilmez, sunucu günlüğüne yazılır.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Dedektif Orhan <bilgi@dedektiforhan.com>"

# --- İlk yönetici hesabı (yalnız seed betiği kullanır) ---
ADMIN_EMAIL="orhantumerkantt@gmail.com"
ADMIN_SIFRE="degistir-beni"
